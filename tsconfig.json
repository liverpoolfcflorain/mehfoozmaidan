{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["main.js", "server.js", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "dist"]
}